[
  {
    "id": "tab_lab3",
    "type": "tab",
    "label": "IoT Lab 3 Pipeline",
    "disabled": false,
    "info": "Sensor MQTT → Alert Logic → Dashboard"
  },
  {
    "id": "broker_hivemq",
    "type": "mqtt-broker",
    "name": "HiveMQ Public",
    "broker": "broker.hivemq.com",
    "port": "1883",
    "clientid": "nodered-lab3",
    "autoConnect": true,
    "usetls": false,
    "keepalive": "60",
    "cleansession": true
  },
  {
    "id": "mqtt_in",
    "type": "mqtt in",
    "z": "tab_lab3",
    "name": "Sensor Input",
    "topic": "iot/lab/sensor1",
    "qos": "0",
    "datatype": "auto",
    "broker": "broker_hivemq",
    "x": 120,
    "y": 100,
    "wires": [["json_parse"]]
  },
  {
    "id": "json_parse",
    "type": "json",
    "z": "tab_lab3",
    "name": "Parse JSON",
    "property": "payload",
    "action": "obj",
    "pretty": false,
    "x": 300,
    "y": 100,
    "wires": [["debug_raw", "alert_fn"]]
  },
  {
    "id": "debug_raw",
    "type": "debug",
    "z": "tab_lab3",
    "name": "Raw Reading",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "x": 480,
    "y": 60,
    "wires": []
  },
  {
    "id": "alert_fn",
    "type": "function",
    "z": "tab_lab3",
    "name": "Alert Logic",
    "func": "const TEMP_HIGH = 35.0;\nconst TEMP_LOW  = 10.0;\nconst temp = msg.payload.temp_c;\nconst hum  = msg.payload.hum_pct;\nmsg.payload.alert = temp > TEMP_HIGH ? 'HIGH_TEMP' : temp < TEMP_LOW ? 'LOW_TEMP' : 'OK';\nmsg.payload.heatIndex = +(temp + 0.33*(hum/100*6.105*Math.exp(17.27*temp/(237.7+temp)))-4.0).toFixed(2);\nmsg.payload.timestamp = new Date().toISOString();\nif (msg.payload.alert !== 'OK') { return [null, msg]; }\nreturn [msg, null];",
    "outputs": 2,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 480,
    "y": 120,
    "wires": [["gauge_temp", "chart_temp"], ["debug_alert", "mqtt_alert"]]
  },
  {
    "id": "gauge_temp",
    "type": "ui_gauge",
    "z": "tab_lab3",
    "name": "Temperature Gauge",
    "group": "dash_group",
    "order": 1,
    "width": 6,
    "height": 4,
    "gtype": "gage",
    "title": "Temperature",
    "label": "°C",
    "format": "{{value.temp_c}}",
    "min": 0,
    "max": 50,
    "colors": ["#00b500", "#e6e600", "#ca3838"],
    "seg1": 25,
    "seg2": 35,
    "x": 700,
    "y": 100,
    "wires": []
  },
  {
    "id": "chart_temp",
    "type": "ui_chart",
    "z": "tab_lab3",
    "name": "Temperature Chart",
    "group": "dash_group",
    "order": 2,
    "width": 12,
    "height": 6,
    "label": "Temperature over time",
    "chartType": "line",
    "legend": "false",
    "xformat": "HH:mm:ss",
    "interpolate": "linear",
    "nodata": "No data yet",
    "dot": false,
    "ymin": "",
    "ymax": "",
    "removeOlder": 30,
    "removeOlderPoints": "30",
    "removeOlderUnit": "3600",
    "cutout": 0,
    "useOneColor": false,
    "colors": ["#1f77b4"],
    "x": 700,
    "y": 140,
    "wires": [[]]
  },
  {
    "id": "debug_alert",
    "type": "debug",
    "z": "tab_lab3",
    "name": "ALERT",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "x": 700,
    "y": 180,
    "wires": []
  },
  {
    "id": "mqtt_alert",
    "type": "mqtt out",
    "z": "tab_lab3",
    "name": "Publish Alert",
    "topic": "iot/alerts",
    "qos": "0",
    "retain": false,
    "respTopic": "",
    "contentType": "",
    "broker": "broker_hivemq",
    "x": 700,
    "y": 220,
    "wires": []
  },
  {
    "id": "dash_group",
    "type": "ui_group",
    "name": "Sensor Dashboard",
    "tab": "dash_tab",
    "order": 1,
    "disp": true,
    "width": 12,
    "collapse": false
  },
  {
    "id": "dash_tab",
    "type": "ui_tab",
    "name": "IoT Lab 3",
    "icon": "dashboard",
    "disabled": false,
    "hidden": false
  }
]
